{
  "name": "erdikoroglu/laravel-service-scaffold",
  "description": "Laravel için otomatik Model, Repository, Service scaffold komutu.",
  "type": "library",
  "keywords": ["laravel", "artisan", "scaffold", "service"],
  "license": "MIT",
  "authors": [
    {
      "name": "Erdi KOROGLU",
      "email": "erdi.koroglu@w3.net.tr"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/console": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "YourUsername\\LaravelServiceScaffold\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "erdikoroglu\\LaravelServiceScaffold\\LaravelServiceScaffoldServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}